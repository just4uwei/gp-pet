{
  "name": "gp-pet",
  "version": "0.0.0",
  "private": true,
  "description": "悬浮条形态的 A 股量化信号提醒工具 · 本地存储 · 免登录 · 不下单",
  "main": "./out/main/index.js",
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "package": "pnpm build && node scripts/package.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"docs/**/*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "backtest": "tsx src/backtest/cli.ts",
    "audit:regime": "tsx src/backtest/regime-audit.ts",
    "audit:subsignals": "tsx src/backtest/subsignal-audit.ts",
    "audit:random": "tsx src/backtest/random-audit.ts",
    "verify:indicators": "node scripts/verify/run.mjs",
    "fixtures:record": "node scripts/record-fixtures.mjs",
    "fetch:history": "node scripts/fetch-history.mjs",
    "build:universe": "node scripts/build-universe.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.4.4",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "framer-motion": "^13.1.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  }
}
