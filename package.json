{
  "name": "gp-pet",
  "version": "0.0.0",
  "private": true,
  "description": "桌宠形态的 A 股量化信号提醒工具 · 本地存储 · 免登录 · 不下单",
  "main": "./out/main/index.js",
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "package": "pnpm build && electron-builder --win --config electron-builder.yml",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"docs/**/*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "backtest": "tsx src/backtest/cli.ts",
    "verify:indicators": "node scripts/verify/run.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "undici": "^7.0.0",
    "zod": "^3.23.0",
    "electron-log": "^5.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "eslint": "^9.0.0",
    "framer-motion": "^11.3.0",
    "playwright": "^1.45.0",
    "postcss": "^8.4.39",
    "prettier": "^3.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0",
    "zustand": "^4.5.0"
  }
}
